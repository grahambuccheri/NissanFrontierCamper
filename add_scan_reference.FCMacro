# Adds the aligned Polycam bed scan to the open FreeCAD document as a ghosted reference.
# Run AFTER frontier_camper_with_bed.FCMacro (document "FrontierBedCamper" must be active).
# Looks for bed_scan_aligned_mm.stl in the user's Downloads folder.
# Scan is ~10% oversize in all axes vs. tape measurements; scaled by 0.905 below.
import os
import FreeCAD as App, FreeCADGui, Mesh

SCAN_NAME = "bed_scan_aligned_mm.stl"
SCAN_PATH = os.path.join(os.path.expanduser("~"), "Downloads", SCAN_NAME)
if not os.path.exists(SCAN_PATH):
    raise FileNotFoundError("Scan not found: " + SCAN_PATH)

SX = SY = SZ = 0.905   # length / width / height scale (about the tailgate-left-floor origin)

doc = App.ActiveDocument or App.newDocument("FrontierBedCamper")
m = Mesh.Mesh(SCAN_PATH)
mat = App.Matrix(); mat.scale(SX, SY, SZ)
m.transform(mat)
obj = doc.addObject("Mesh::Feature", "BedScan")
obj.Mesh = m
obj.ViewObject.ShapeColor = (0.2, 0.5, 0.9)
obj.ViewObject.Transparency = 20
doc.recompute()
FreeCADGui.ActiveDocument.ActiveView.fitAll()
